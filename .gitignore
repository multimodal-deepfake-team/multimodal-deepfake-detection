# ---------------- Python ----------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------------- Virtual environments ----------------
# NOTE: do not add bare `Scripts/`, `Lib/` or `Include/` here - gitignore is
# case-insensitive on Windows and they would swallow the project's `scripts/`
# package. The venv directories above are enough.
venv/
.venv/
env/

# ---------------- Datasets (too large / licensed) ----------------
dataset/
processed/*
# fusion evaluation report is a text artefact the Model Metrics page reads,
# so it is committed like everything else in results/
!processed/fusion_evaluation.txt

# ---------------- Trained weights ----------------
# Everything is excluded by default (size/licensing), except the three
# checkpoints the deployed dashboard cannot run without. Those are committed
# on purpose so a fresh clone - and Streamlit Community Cloud - has them:
#   saved_models/video_binary_small.pth   ~45 MB
#   saved_models/audio_binary_small.pth    ~0.8 MB
#   weights/yolov8n-face.pt                 ~6 MB
saved_models/*
weights/*
*.pt
*.pth
*.pkl
# negations must come last - a later rule wins in gitignore
!saved_models/video_binary_small.pth
!saved_models/audio_binary_small.pth
!weights/yolov8n-face.pt

# ---------------- Scratch / debug artefacts ----------------
debug_faces/
_verify_tmp/
*.log
*.tmp
*.wav
/test_audio/

# ---------------- Streamlit / Jupyter ----------------
.ipynb_checkpoints/
# keep .streamlit/config.toml (theme) committed, never the secrets
.streamlit/secrets.toml

# ---------------- OS ----------------
.DS_Store
Thumbs.db
