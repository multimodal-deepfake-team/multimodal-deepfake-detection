# ---------------- Virtual environments ----------------
# NOTE: do not add bare `Scripts/`, `Lib/` or `Include/` here - gitignore is
# case-insensitive on Windows and they would swallow the project's `scripts/`
# package. The venv directories above are enough.
venv/
.venv/
env/

# ---------------- Datasets (too large / licensed) ----------------
dataset/
processed/

# ---------------- Trained weights ----------------
saved_models/
weights/
*.pt
*.pth
*.pkl

# ---------------- Scratch / debug artefacts ----------------
debug_faces/
_verify_tmp/
*.log
*.tmp
*.wav
/test_audio/

# ---------------- Streamlit / Jupyter ----------------
.ipynb_checkpoints/
# keep .streamlit/config.toml (theme) committed, never the secrets
.streamlit/secrets.toml

# ---------------- OS ----------------
.DS_Store
Thumbs.db
